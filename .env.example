# Copy this file to .env and paste your key once.
GETSONGBPM_API_KEY=your-api-key-here

# Optional remote audio storage. When all values are set, new uploaded and
# YouTube-imported audio files are stored in Cloudflare R2 instead of locally.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=ydkmusic-audio
R2_REGION=auto
